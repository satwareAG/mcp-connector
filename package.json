{
  "name": "@typingmind/mcp",
  "version": "1.2.1",
  "repository": "https://github.com/TypingMind/typingmind-mcp",
  "description": "Model Context Protocol (MCP) servers runner for TypingMind",
  "main": "lib/server.js",
  "bin": {
    "@typingmind/mcp": "./bin/index.js"
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "mcp",
    "model",
    "context",
    "protocol",
    "typingmind"
  ],
  "author": "TypingMind",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "json-stable-stringify": "^1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "c8": "^10.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "@types/jest": "^29.5.14"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
